{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cfl-manager",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": ["-m", "cfl", "serve", "--port", "8000", "--reload"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    }
  ]
}
