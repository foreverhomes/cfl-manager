# Copy to .env and edit.
FANTRAX_LEAGUE_ID=
# Your team id (run `python -m cfl teams` to list them). Enables /teams/me/... and CLI defaults.
FANTRAX_MY_TEAM_ID=
# CFL_DB_PATH=data/league.db
# A Postgres database to use instead of the SQLite file, e.g. the Neon database the Vercel site
# uses, so the CLI and the site share data (see README, "Deploying to Vercel").
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Weight of a last-season game vs a this-season game when blending per-game rates.
# CFL_PRIOR_SEASON_WEIGHT=0.5
# Pseudo-games of league-average production added to every player (stabilises tiny samples).
# CFL_SHRINK_GAMES=5
# Sheet publishing for app-owned teams (see README, "Publishing your team to its Google Sheet").
# CFL_SHEET_PUBLISH_URL=https://script.google.com/macros/s/<deployment-id>/exec
# CFL_SHEET_PUBLISH_TOKEN=   (python -m cfl publish --script generates one)
# salary_sheets.json's contents, where there's no such file (a Vercel deployment).
# CFL_SALARY_SHEETS_JSON={"me": "https://docs.google.com/spreadsheets/d/<id>/edit"}
# Sign in with Google (see README, "Logins"). Leave GOOGLE_CLIENT_ID unset locally for no logins.
# GOOGLE_CLIENT_ID=<id>.apps.googleusercontent.com
# CFL_SESSION_SECRET=   (a long random string, e.g. openssl rand -base64 32)
# CFL_ADMIN_EMAILS=you@gmail.com
